<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AuditDW">
      <DataSourceReference>/Data Sources/AuditDW</DataSourceReference>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=sql02;Initial Catalog=AuditDW</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="AuditFacts">
      <Query>
        <DataSourceName>AuditDW</DataSourceName>
        <CommandText>SELECT s.SiteName, a.AuditDate, a.SampleCount
FROM dbo.AuditFact a
JOIN dbo.DimSite s ON a.SiteKey = s.SiteKey
WHERE a.AuditDate >= @StartDate</CommandText>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="SiteName">
          <DataField>SiteName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AuditDate">
          <DataField>AuditDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SampleCount">
          <DataField>SampleCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="StartDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateAdd("d", -30, Today())</Value>
        </Values>
      </DefaultValue>
      <Prompt>Start Date</Prompt>
    </ReportParameter>
  </ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Subreport Name="DetailSubreport">
            <ReportName>SamplingDetail</ReportName>
          </Subreport>
          <Tablix Name="SiteSummary">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>2in</Width></TablixColumn>
                <TablixColumn><Width>1in</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="SiteHeader">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>Site</Value></TextRun></TextRuns></Paragraph></Paragraphs>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="SampleValue">
                          <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!SampleCount.Value)</Value></TextRun></TextRuns></Paragraph></Paragraphs>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember>
                  <Group Name="SiteGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!SiteName.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>AuditFacts</DataSetName>
            <Top>0.6in</Top>
            <Left>0.2in</Left>
            <Height>1in</Height>
            <Width>3in</Width>
          </Tablix>
        </ReportItems>
        <Height>2.5in</Height>
      </Body>
      <Page>
        <PageHeader>
          <Height>0.5in</Height>
          <ReportItems>
            <Textbox Name="Title">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>Sampling Report Pharmacy Audit</Value></TextRun></TextRuns></Paragraph></Paragraphs>
            </Textbox>
          </ReportItems>
        </PageHeader>
        <PageFooter>
          <Height>0.3in</Height>
          <ReportItems>
            <Textbox Name="Footer">
              <Paragraphs><Paragraph><TextRuns><TextRun><Value>Confidential</Value></TextRun></TextRuns></Paragraph></Paragraphs>
            </Textbox>
          </ReportItems>
        </PageFooter>
      </Page>
    </ReportSection>
  </ReportSections>
  <Width>6in</Width>
</Report>
