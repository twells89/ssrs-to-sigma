{
    "version": 1,
    "reports": [
        {
            "report": "ReportSections2016",
            "sourceFile": "ReportSections2016.rdl",
            "dataSources": [
                {
                    "name": "AuditDW",
                    "reference": "/Data Sources/AuditDW",
                    "provider": "SQL",
                    "connectString": "Data Source=sql02;Initial Catalog=AuditDW"
                }
            ],
            "dataSets": [
                {
                    "name": "AuditFacts",
                    "dataSourceName": "AuditDW",
                    "commandText": "SELECT s.SiteName, a.AuditDate, a.SampleCount\nFROM dbo.AuditFact a\nJOIN dbo.DimSite s ON a.SiteKey = s.SiteKey\nWHERE a.AuditDate >= @StartDate",
                    "isStoredProc": false,
                    "queryParameters": [
                        {
                            "name": "@StartDate",
                            "value": "=Parameters!StartDate.Value"
                        }
                    ],
                    "fields": [
                        {
                            "name": "SiteName",
                            "dataField": "SiteName",
                            "expression": null,
                            "calculated": false,
                            "typeName": "System.String"
                        },
                        {
                            "name": "AuditDate",
                            "dataField": "AuditDate",
                            "expression": null,
                            "calculated": false,
                            "typeName": "System.DateTime"
                        },
                        {
                            "name": "SampleCount",
                            "dataField": "SampleCount",
                            "expression": null,
                            "calculated": false,
                            "typeName": "System.Int32"
                        }
                    ]
                }
            ],
            "parameters": [
                {
                    "name": "StartDate",
                    "dataType": "DateTime",
                    "multiValue": false,
                    "nullable": false,
                    "prompt": "Start Date",
                    "defaultValues": [
                        "=DateAdd(\"d\", -30, Today())"
                    ],
                    "validValuesQuery": null,
                    "validValuesStatic": null
                }
            ],
            "bodyItems": [
                {
                    "kind": "subreport",
                    "name": "DetailSubreport",
                    "reportName": "SamplingDetail",
                    "flag": "subreport -> separate page / drillthrough, multi-pass"
                },
                {
                    "kind": "tablix",
                    "name": "SiteSummary",
                    "shape": "table",
                    "dataSetName": "AuditFacts",
                    "rowGroups": [
                        {
                            "name": "SiteGroup",
                            "expressions": [
                                "=Fields!SiteName.Value"
                            ]
                        }
                    ],
                    "columnGroups": [],
                    "valueExpressions": [
                        "=Sum(Fields!SampleCount.Value)"
                    ],
                    "position": {
                        "top": "0.6in",
                        "left": "0.2in",
                        "width": "3in",
                        "height": "1in"
                    }
                }
            ],
            "pageHeaderItems": [
                {
                    "kind": "textbox",
                    "name": "Title",
                    "value": "Sampling Report Pharmacy Audit"
                }
            ],
            "pageFooterItems": [
                {
                    "kind": "textbox",
                    "name": "Footer",
                    "value": "Confidential"
                }
            ]
        }
    ]
}
